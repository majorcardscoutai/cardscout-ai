# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or paste these values into chat or browser code.

# Phase 2 — Supabase (Project Settings → API Keys / Data API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Password to open the app (choose your own)
APP_PASSWORD=choose-a-strong-password

# Phase 3 — eBay Developers Program, PRODUCTION keyset (server-side only)
EBAY_CLIENT_ID=your-app-id
EBAY_CLIENT_SECRET=your-cert-id
# eBay Partner Network Campaign ID (10 digits) — tracked "View on eBay" links
EBAY_CAMPAIGN_ID=

# Phase 4 — automatic scanning & alerts (server-side only)
CRON_SECRET=long-random-string        # same value in Vercel AND as a GitHub Actions secret
HEALTH_KEY=another-long-random-string   # optional: switches on /api/cron/health for an uptime monitor
RESEND_API_KEY=re_xxxxxxxx            # resend.com free account
ALERT_EMAIL=you@example.com           # where deal alerts are sent (your Resend account email)

# Phone notifications (Web Push) — generate on your Mac, see PROGRESS.md
VAPID_PUBLIC_KEY=BXXXXXXXX            # public, ~87 characters
VAPID_PRIVATE_KEY=xxxxxxxx            # SECRET, ~43 characters
# VAPID_SUBJECT=mailto:you@example.com # optional; defaults to ALERT_EMAIL

# Optional: FX_LIVE=off to use only the Settings exchange rate
