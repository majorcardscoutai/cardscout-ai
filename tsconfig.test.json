  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": ".test-build",
